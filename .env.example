# Postgres — direct connection string
DATABASE_URL=postgresql://lodestar:password@localhost:5432/lodestar

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Cron protection (random string — used when crons run on Vercel)
CRON_SECRET=

# Amp — self-hosted ampd node for Horizon event history (optional)
# See: /blog/run-local-amp-node
AMP_ENDPOINT=
AMP_TOKEN=

# Ollama — local inference for Lodie AI assistant (optional)
OLLAMA_URL=
OLLAMA_SECRET=

# Push Protocol — delegator notifications (optional)
# Create a channel at https://push.org and fund it with 50 PUSH tokens
PUSH_CHANNEL_ADDRESS=
PUSH_CHANNEL_PRIVATE_KEY=
PUSH_ENV=staging

# Lodestar developer platform — session signing
# Random secret for signing session cookies (openssl rand -hex 32)
SESSION_SECRET=
# IPFS API — optional override for subgraph artifact uploads (defaults to https://api.thegraph.com/ipfs)
GRAPH_IPFS_URL=

# Indexer-agent management API — for queuing presentPOI actions (bounty claims).
# Point at the management API endpoint (port 8000), exposed via a reverse proxy.
# If the endpoint requires Basic auth, set INDEXER_AGENT_TOKEN="user:password".
INDEXER_AGENT_URL=
INDEXER_AGENT_TOKEN=

# Token API (graph-token-api) — JWT from thegraph.com market.
# Required by the /tokens analytics section. Server-side only; never exposed to the client.
TOKEN_API_KEY=

# Optional RPC overrides for the /tokens contract-vs-EOA classifier.
# Without these, public RPCs (publicnode, llamarpc, 1rpc) are used and
# may throttle under directory fan-out. Provide a private/paid URL to
# raise the ceiling.
MAINNET_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=
OPTIMISM_RPC_URL=

# Foghorn — network-quality judge backend. Base URL of the self-hosted Foghorn
# API (no trailing slash); the /api/foghorn proxy prepends /v1/. Leave empty to
# disable the /foghorn pages and indexer grade column (they degrade gracefully).
FOGHORN_API_URL=


# Nuthatch: every protocol panel reads a nest through this one origin, and nothing falls back to
# anything else when it is unavailable (nuthatch#1160). README "Where the data comes from" is the
# map of route -> nest.
SERVABILITY_DEAD_ROUNDS="3"          # RFC-006 D5 (lodestar#59): consecutive probe rounds with no serving
                                     # operator before /subgraphs/[hash] may say "Effectively dead". Floors at 2;
                                     # a gateway-served round can never be dead and resets the count. Rounds are
                                     # persisted in servability_rounds (migrations/016).
NUTHATCH_URL=""                      # e.g. https://nuthatch.<host>.sslip.io
NUTHATCH_USER=""                     # basic-auth user in front of the nests
NUTHATCH_PASSWORD=""                 # basic-auth password

# Per-route path overrides. Each names the nest a route reads, under NUTHATCH_URL. Only set one when a
# nest is staged somewhere other than its usual path; the defaults are the production layout.
NUTHATCH_ALLOCATIONS_BASE_PATH=""    # defaults to "/alloc" (graph-allocations-nest): deployments, signal, allocations,
                                     # the allocations ingest cron, subgraph history and curation
NUTHATCH_INDEXERS_BASE_PATH=""       # defaults to "/alloc": /api/indexers, indexer profile and status, stake history,
                                     # APR provenance, indexing status, the tap-provision cron
NUTHATCH_NETWORK_BASE_PATH=""        # defaults to "/alloc": /api/network-stats and /api/grt-flow
NUTHATCH_EPOCHS_BASE_PATH=""         # defaults to "/alloc": /api/epochs, /api/token-metrics, the epochs ingest cron
NUTHATCH_PROVISIONS_BASE_PATH=""     # defaults to "/alloc": /api/provisions
NUTHATCH_PORTFOLIO_BASE_PATH=""      # defaults to "/alloc": /api/portfolio and /api/rewards-history
NUTHATCH_CURATORS_BASE_PATH=""       # defaults to "/alloc": /api/curators
NUTHATCH_PAYMENTS_BASE_PATH=""       # defaults to "/alloc": escrow accounts and transactions in /api/payments
NUTHATCH_HORIZON_BASE_PATH=""        # defaults to "/alloc": tally collections in /api/payments, provisions in the
                                     # horizon-activity cron. "/horizon" on the host is an alias of "/alloc"
NUTHATCH_POI_BASE_PATH=""            # defaults to "/alloc": /api/poi
NUTHATCH_FEED_BASE_PATH=""           # defaults to "/alloc": epoch summaries in /api/feed
NUTHATCH_REFRESH_BASE_PATH=""        # defaults to "/alloc": every input of the indexer refresh cron
NUTHATCH_DELEGATIONS_BASE_PATH=""    # defaults to "/alloc": the delegation-events ingest cron and the
                                     # horizon-activity cron
NUTHATCH_DISPUTES_BASE_PATH=""       # defaults to "/alloc": the disputes ingest cron
NUTHATCH_RAV_BASE_PATH=""            # defaults to "/alloc": the RAV (query-fee) ingest cron
NUTHATCH_GNS_BASE_PATH=""            # defaults to "/gns" (graph-gns-nest): subgraph names, versions, search, the
                                     # warm-ipfs cron
NUTHATCH_DIPS_BASE_PATH=""           # which DIPS nest /api/dips/agreements reads; "/dips" (Arbitrum One, the
                                     # default) or "/dips-sepolia", where the agreement lifecycle has rows
